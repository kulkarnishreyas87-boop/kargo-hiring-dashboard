# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local sqlite db (superseded by Neon) + derived resume text/CVs — not meant for public redistribution,
# and the deployed app doesn't need them (Postgres holds the ingested data).
# rubric.md and jds/ stay tracked: the running app reads them at request time.
/data/kargo.db*
/data/extracted/
/data/resumes/

# neon
.neon

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
