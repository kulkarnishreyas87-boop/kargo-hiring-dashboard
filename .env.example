# Gemini (used for all 4 pipeline steps: score, guardrail/rank, brief, email draft)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Resend (sending is always a manual click from the dashboard, never automatic)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# If you've verified a domain in Resend, set RESEND_FROM_EMAIL to your verified address instead,
# e.g. hiring@yourdomain.com — until then the sandbox sender can only deliver to the email
# address you signed up to Resend with.

# Postgres (Neon). Local dev and the deployed app both read this.
DATABASE_URL=

# HTTP Basic Auth gate for the deployed site — this dashboard holds real candidate data.
# Leave unset locally to skip the login prompt in dev; set it in Vercel's env vars for prod.
SITE_PASSWORD=
